<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Back Arrow -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/moonstone"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@+id/tvTitle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create account"
        android:fontFamily="@font/inter"
        android:textColor="@color/coral"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- General Error (Added at Top) -->
    <LinearLayout
        android:id="@+id/layoutGeneralError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/coral"
            android:contentDescription="Error"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvGeneralErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registration failed."
            android:fontFamily="@font/inter"
            android:textColor="@color/coral"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Email Section -->
    <TextView
        android:id="@+id/labelEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:fontFamily="@font/inter"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutGeneralError" />

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_field"
        android:hint="example@example.com"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"
        android:textColor="@color/text"
        android:textColorHint="@color/hint_color"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelEmail" />

    <!-- Email Error (Layout with Icon) -->
    <LinearLayout
        android:id="@+id/layoutEmailError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etEmail">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/coral"
            android:contentDescription="Error"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tvEmailErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Invalid email. Must contain a domain."
            android:fontFamily="@font/inter"
            android:textColor="@color/coral"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Password Section -->
    <TextView
        android:id="@+id/labelPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        android:fontFamily="@font/inter"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutEmailError" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter password"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:textColor="@color/text"
        android:textColorHint="@color/hint_color"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        android:drawableEnd="@drawable/ic_visibility_off"
        android:drawableTint="@color/text"
        android:drawablePadding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelPassword" />

    <!-- Password Error (Layout with Icon) -->
    <LinearLayout
        android:id="@+id/layoutPasswordError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etPassword">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/coral"
            android:contentDescription="Error"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password must be at least 5 characters."
            android:fontFamily="@font/inter"
            android:textColor="@color/coral"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Confirm Password Section -->
    <TextView
        android:id="@+id/labelConfirmPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Password"
        android:fontFamily="@font/inter"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutPasswordError" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_field"
        android:hint="Re-enter password"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:textColor="@color/text"
        android:textColorHint="@color/hint_color"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        android:drawableEnd="@drawable/ic_visibility_off"
        android:drawableTint="@color/text"
        android:drawablePadding="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/labelConfirmPassword" />

    <!-- Confirm Password Error (Layout with Icon) -->
    <LinearLayout
        android:id="@+id/layoutConfirmError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etConfirmPassword">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/coral"
            android:contentDescription="Error"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passwords do not match."
            android:fontFamily="@font/inter"
            android:textColor="@color/coral"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Register Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegister"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Sign up"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/moonstone"
        app:cornerRadius="12dp"
        android:layout_marginTop="32dp"
        android:textAllCaps="false"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutConfirmError" />

    <!-- OR Divider -->
    <LinearLayout
        android:id="@+id/layoutOr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/btnRegister">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E0E0E0"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OR"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#E0E0E0"/>
    </LinearLayout>

    <!-- Google Image Button -->
    <ImageButton
        android:id="@+id/btnGoogle"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:adjustViewBounds="true"
        android:background="@drawable/google"
        android:contentDescription="@string/none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutOr" />

    <!-- Footer Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="By using Zenith, you agree to the"
            android:fontFamily="@font/inter"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terms and Privacy Policy."
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>