<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ehr">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/divider"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="15dp">


                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medicine List"
                    style="@style/Header"
                    android:textColor="@color/coral"/>

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/medicineQR"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/qr_icon"
                    android:contentDescription="@string/none"
                    tools:ignore="TouchTargetSizeCheck"
                    android:layout_marginEnd="15dp"/>

                <ImageButton
                    android:id="@+id/btnAddMed"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/add"
                    android:contentDescription="@string/none"
                    tools:ignore="TouchTargetSizeCheck" />

                <ImageButton
                    android:id="@+id/imageButton6"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/print"
                    android:contentDescription="@string/none"
                    tools:ignore="TouchTargetSizeCheck" />

            </LinearLayout>

            <!-- RECYCLER VIEW (Replaces the Table Image) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMedList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_medication"
                android:layout_marginBottom="120dp"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>