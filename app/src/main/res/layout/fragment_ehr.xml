<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ehr">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <!-- PATIENT HEADER SECTION (Unchanged) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="25dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView15"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:src="@drawable/patient_picture" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="DOB: 12/21/1979"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView14"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="Weight: 167 lbs."
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView15"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter"
                            android:text="Age: 46 years"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="MRN: 20036548"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView13"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="POB: Philippines"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textView17"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="Sex: Male"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:layout_gravity="start">

                            <TextView
                                android:id="@+id/textView18"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="Allergies: "
                                android:textColor="@color/text"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textView19"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="@string/view"
                                android:textColor="@color/moonstone"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/imageView17"
                                android:layout_width="10dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginStart="2dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/open" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textView20"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            android:text="FIN: 1005-63251"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/textView21"
                style="@style/Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="5dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp"
                android:text="Alvares, Julian Ramos"
                android:textColor="@color/caribbean"
                android:textSize="22sp"/>
            <ImageButton
                android:id="@+id/imageButton4"
                android:layout_width="144dp"
                android:layout_height="30dp"
                android:adjustViewBounds="true"
                android:background="@drawable/edit_patient_info"
                android:clickable="true"
                android:contentDescription="Edit Patient Info"
                android:focusable="true"
                android:scaleType="fitStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/patient_mrn_fin_text"
                tools:ignore="HardcodedText,TouchTargetSizeCheck"
                android:layout_marginBottom="15dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="15dp"/>

            <!-- ACTION BUTTONS ROW -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/divider"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="15dp">


                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Medicine List"
                    style="@style/Header"
                    android:textColor="@color/coral"/>

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/medicineQR"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/qr_icon"
                    android:contentDescription="@string/none"
                    tools:ignore="TouchTargetSizeCheck"
                    android:layout_marginEnd="15dp"/>

                <ImageButton
                    android:id="@+id/btnAddMed"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/add"
                    android:contentDescription="@string/none"
                    tools:ignore="TouchTargetSizeCheck" />

                <ImageButton
                    android:id="@+id/imageButton6"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    android:background="@drawable/print"
                    android:contentDescription="@string/none"
                    tools:ignore="TouchTargetSizeCheck" />

            </LinearLayout>

            <!-- RECYCLER VIEW (Replaces the Table Image) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMedList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_medication"
                android:layout_marginBottom="120dp"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>