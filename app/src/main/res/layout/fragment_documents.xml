<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingBottom="120dp"
    android:clipToPadding="false"
    tools:context=".Documents">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
        android:id="@+id/cv_profile"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/patient_profile_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Patient Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/default_profile_pic"
            tools:ignore="HardcodedText" />
    </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/patient_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Alvarez, Julian R."
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cv_profile"
            app:layout_constraintTop_toTopOf="@+id/cv_profile"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/patient_age_mrn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Age: 46 years"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@+id/patient_name_text"
            app:layout_constraintTop_toBottomOf="@+id/patient_name_text"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/lbl_allergies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Allergies:"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/patient_age_mrn_text"
            app:layout_constraintStart_toEndOf="@+id/patient_age_mrn_text"
            app:layout_constraintTop_toTopOf="@+id/patient_age_mrn_text"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/patient_allergies_text"
            android:layout_width="35dp"
            android:layout_height="21dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:text="View"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/lbl_allergies"
            app:layout_constraintStart_toEndOf="@+id/lbl_allergies"
            app:layout_constraintTop_toTopOf="@+id/lbl_allergies"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/patient_mrn_fin_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="MRN: 200365448   FIN: 1005-63251"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/patient_name_text"
            app:layout_constraintTop_toBottomOf="@+id/patient_age_mrn_text"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/imageButton4"
            android:layout_width="144dp"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:background="@drawable/edit_patient_info"
            android:clickable="true"
            android:contentDescription="Edit Patient Info"
            android:focusable="true"
            android:scaleType="fitStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/patient_mrn_fin_text"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />

        <View
            android:id="@+id/separator"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageButton4" />

        <ImageButton
            android:id="@+id/imageButton8"
            android:layout_width="96dp"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:background="@drawable/qr_sync"
            android:contentDescription="@string/none"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separator"
            tools:ignore="TouchTargetSizeCheck" />

        <ImageButton
            android:id="@+id/imageButton6"
            android:layout_width="144dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:background="@drawable/add_document"
            android:contentDescription="@string/none"
            android:scaleType="fitStart"
            app:layout_constraintBottom_toBottomOf="@+id/imageButton8"
            app:layout_constraintStart_toEndOf="@+id/imageButton8"
            app:layout_constraintTop_toTopOf="@+id/imageButton8"
            tools:ignore="TouchTargetSizeCheck,ImageContrastCheck" />

        <SearchView
            android:id="@+id/document_search_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/search_bar_background"
            android:queryHint="Search Documents"
            app:iconifiedByDefault="false"
            app:layout_constraintEnd_toStartOf="@+id/filter_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageButton8" />

        <ImageButton
            android:id="@+id/filter_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Filter"
            android:src="@drawable/ic_filter"
            app:layout_constraintBottom_toBottomOf="@+id/document_search_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/document_search_view"
            tools:ignore="TouchTargetSizeCheck" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/document_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/document_search_view" />

        <LinearLayout
            android:id="@+id/layout_no_documents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/document_search_view">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="No Documents"
                android:src="@android:drawable/ic_menu_report_image"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/raleway_bold"
                android:text="No Documents to Show"
                android:textColor="#90A4AE"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Tap 'New Document' to add one"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>