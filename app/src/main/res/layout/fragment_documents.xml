<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Documents">

    <!--
    *** START: Dynamic Patient Info Header (Replaces ImageView28) ***
    This structure is based on the reference image's layout.
    -->
    <LinearLayout
        android:id="@+id/patient_info_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <!-- Profile Picture (Rounded) -->
        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/patient_profile_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Patient Profile"
                android:scaleType="centerCrop"
                android:src="@drawable/alvarez_profile"
                tools:ignore="HardcodedText" />
        </androidx.cardview.widget.CardView>

        <!-- Patient Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/patient_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alvarez, Julian R."
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/patient_age_mrn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age: 46 years"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Allergies:"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/patient_allergies_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="View"
                    android:textColor="#78909C"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText,TouchTargetSizeCheck" />
            </LinearLayout>

            <TextView
                android:id="@+id/patient_mrn_fin_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MRN: 200365448   FIN: 1005-63251"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </LinearLayout>
    <!-- *** END: Dynamic Patient Info Header *** -->


    <!-- Change Patient / Edit Patient Info Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:orientation="horizontal">
        <!-- Change Patient Button (ID: imageButton3) -->
        <ImageButton
            android:id="@+id/imageButton3"
            android:layout_width="135dp"
            android:layout_height="35dp"
            android:adjustViewBounds="true"
            android:background="@drawable/change_patient"
            android:contentDescription="@string/none"
            tools:ignore="TouchTargetSizeCheck,DuplicateSpeakableTextCheck" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:ignore="InefficientWeight" />
        <!-- Edit Patient Info Button (ID: imageButton4) - Now Clickable -->
        <ImageButton
            android:id="@+id/imageButton4"
            android:layout_width="135dp"
            android:layout_height="35dp"
            android:adjustViewBounds="true"
            android:background="@drawable/edit_patient_info"
            android:clickable="true"
            android:contentDescription="Edit Patient Info"
            android:focusable="true"
            tools:ignore="HardcodedText,TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="20dp"
        android:background="@color/accent" />

    <!-- QR Sync / OCR / New Document Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">
        <!-- QR Sync Button (ID: imageButton8) -->
        <ImageButton
            android:id="@+id/imageButton8"
            android:layout_width="50dp"
            android:layout_height="35dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@drawable/qr_sync"
            android:contentDescription="@string/none"
            tools:ignore="TouchTargetSizeCheck" />
        <!-- OCR Button (ID: imageButton5) -->
        <ImageButton
            android:id="@+id/imageButton5"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:adjustViewBounds="true"
            android:background="@drawable/ocr_button"
            android:contentDescription="@string/none"
            tools:ignore="TouchTargetSizeCheck" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <!-- New Document Button (ID: imageButton6) -->
        <ImageButton
            android:id="@+id/imageButton6"
            android:layout_width="160dp"
            android:layout_height="35dp"
            android:adjustViewBounds="true"
            android:background="@drawable/new_document"
            android:contentDescription="@string/none"
            tools:ignore="TouchTargetSizeCheck,ImageContrastCheck" />
    </LinearLayout>

    <!-- Search Bar and Filter Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SearchView
            android:id="@+id/document_search_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/search_bar_background"
            android:queryHint="Search Documents"
            app:iconifiedByDefault="false" />

        <ImageButton
            android:id="@+id/filter_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_filter"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <!-- Document List Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/document_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="30dp" />

</LinearLayout>